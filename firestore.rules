rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
    }
    
    // Учебный контент
    match /webinars/{webinarId} { allow write: if true; }
    match /homeworks/{hwId} { allow write: if true; }
    match /submissions/{subId} { allow create, update, delete: if true; }
    
    // Профили учеников (для сохранения стриков) и уведомления
    match /students/{studentId} { allow write: if true; }
    match /notifications/{notifId} { allow write: if true; }
  }
}

